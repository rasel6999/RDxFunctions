<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ════ MacTheme Night (Dark Mode) ════ -->
    <style name="Theme.MacTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:statusBarColor" tools:ignore="ObsoleteSdkInt" tools:targetApi="l">@color/bgToolbar</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:navigationBarColor">@color/bgToolbar</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:windowBackground">@drawable/bg_splash_image</item>
        <item name="android:actionButtonStyle">@style/ActionButtonStyle</item>
        <item name="alertDialogTheme">@style/AlertDialogTheme</item>
        <item name="materialAlertDialogTheme">@style/CustomMaterialDialog</item>

        <item name="logoColor">#ffffff</item>
        <item name="logoColor2">#DEDEDE</item>
        <item name="accentColor">@color/accentColor</item>
        <item name="colorAccent">@color/accentColor</item>
        <item name="colorPrimary">@color/accentColor</item>
        <item name="colorPrimaryDark">@color/linkColor</item>
        <item name="bgColor">@color/bgColor</item>
        <item name="bgColorSec">@color/bgColorSec</item>
        <item name="bgColorError">@color/bgColorError</item>
        <item name="textColor">@color/textColor</item>
        <item name="textColorSec">@color/textColorSec</item>
        <item name="textColorError">@color/textColorError</item>
        <item name="greenCorner">#54D9CE</item>
        <item name="redCorner">#E24284</item>
        <item name="yellowCorner">#FF9800</item>
        <item name="blueCorner">#03A9F4</item>
        <item name="linkColor">@color/linkColor</item>
        <item name="bgToolbar">@color/bgToolbar</item>
        <item name="toolbarBgColor">?attr/bgToolbar</item>
        <item name="iconToolbar">@color/iconToolbar</item>
        <item name="textToolbar">@color/textToolbar</item>
        <item name="textToolbarSec">@color/textToolbarSec</item>
        <item name="textColorLight">#ffffff</item>
        <item name="signInBg">@color/accentColor</item>
        <item name="textColorToolbar">@color/textToolbar</item>
        <item name="textColorToolbarSec">@color/textToolbarSec</item>
        <item name="bgCardComment">@color/bgCardComment</item>
        <item name="bgColorDialogFragment">@color/bgColorDialogFragment</item>
        <item name="colorSuccessToolbar">#009688</item>
        <item name="colorSuccess">#009688</item>
        <item name="colorPendingToolbar">#FFEB3B</item>
        <item name="colorPending">#FFC107</item>
        <item name="colorFailureToolbar">#F44336</item>
        <item name="colorFailure">#F44336</item>
        <item name="colorDebit">#D01760</item>
        <item name="colorDebitText">#D01760</item>
        <item name="colorCreditText">#4DB6AC</item>
        <item name="colorCredit">#4DB6AC</item>
        <item name="bgTimeBar1">#730017</item>
        <item name="bgTimeBar2">#BA0F30</item>
        <item name="colorBgSplash">@color/colorBgSplash</item>
        <item name="colorBgSplash2">@color/colorBgSplash2</item>
        <item name="dashboardHeaderBg">@drawable/bg_dashboard_header_night</item>
        <item name="colorDeepAccent">#A80625</item>
        <item name="colorAccent30">#4DBA0F30</item>
        <item name="addPostBgColor">#1C1C1C</item>
        <item name="bgColorPopUp">#2B2B2B</item>
        <item name="bgColorUnread">#2C1A1D</item>
        <item name="bgColorDark">#121212</item>
        <item name="bgCard">@android:color/transparent</item>
        <item name="google_login_color">#4285F4</item>
        <item name="textColorLightSec">#BDBDBD</item>
        <item name="colorDisable">#757575</item>
        <item name="black">#000000</item>
        <item name="white">#FFFFFF</item>
        <item name="hr">#2C2C2C</item>
        <item name="colorTextSplash">#FFFFFF</item>
        <item name="headerTint">#BA0F30</item>
        <item name="hrBgSec">#1E1E1E</item>
        <item name="colorDeepButton">#757575</item>
        <item name="textColorChatLeft">#E0E0E0</item>
        <item name="textColorChatRight">#FFFFFF</item>
        <item name="bgColorChatLeft">#2A2A2A</item>
        <item name="bgColorChatRight">#BA0F30</item>
        <item name="itemBgColor">#222222</item>
        <item name="itemActionBgColor">#1C1C1C</item>
        <item name="itemTextColor">?attr/textColor</item>
        <item name="itemTextColorSec">?attr/textColorSec</item>
        <item name="msgListBgColor">#151515</item>
        <item name="msgSearchBgColor">#1C1C1C</item>
        <item name="dividerColor">#1AFFFFFF</item>
        <item name="toolbarIconColor">#FFFFFF</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- ════ MacPro Dark Migration Theme ════ -->
    <style name="Theme.MacPro" parent="Theme.MacTheme" />
    <style name="Theme.MacPro.Dark" parent="Theme.MacTheme" />

    <style name="Theme.MacTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.DayNight.ActionBar" />
    <style name="Theme.MacTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.DayNight" />

    <style name="Theme.MacTheme.myBottomSheetDialogTheme">
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="toolbarStyle">@style/MacToolbar</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="bottomSheetDialogTheme">@style/bottomSheetDialogTheme</item>
    </style>

    <style name="Theme.MacTheme.SplashTheme">
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:statusBarColor">@color/bgToolbar</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.MacTheme.NoActionBars">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="datePicker" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="colorPrimary">?attr/textColorSec</item>
        <item name="colorPrimaryDark">?attr/textColor</item>
        <item name="colorAccent">?attr/textColor</item>
    </style>

    <style name="CustomMaterialDialog" parent="@style/ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:background">?attr/bgColor</item>
        <item name="colorOnSurface">?attr/textColor</item>
        <item name="colorPrimary">?attr/linkColor</item>
    </style>

    <style name="ActionButtonStyle" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="android:padding">7dip</item>
    </style>

    <style name="AlertDialogTheme" parent="ThemeOverlay.MaterialComponents.Dialog">
        <item name="buttonBarNegativeButtonStyle">@style/NegativeButtonStyle</item>
        <item name="buttonBarPositiveButtonStyle">@style/PositiveButtonStyle</item>
    </style>

    <style name="NegativeButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">?attr/textColorSec</item>
    </style>

    <style name="PositiveButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">?attr/linkColor</item>
    </style>

    <style name="bottomSheetDialogTheme" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="colorAccent">@color/accentColor</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:navigationBarColor">@color/bgToolbar</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <style name="MacToolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="titleTextColor">@color/textToolbar</item>
    </style>

    <style name="macwapToolbar" parent="@style/ThemeOverlay.AppCompat.ActionBar">
        <item name="colorControlNormal">@color/textToolbar</item>
    </style>

    <style name="MaterialCalendarTheme" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="colorSurface">?attr/bgColor</item>
        <item name="colorOnSurface">?attr/textColorSec</item>
        <item name="colorPrimary">?attr/bgColorSec</item>
        <item name="colorOnPrimary">?attr/textColor</item>
        <item name="buttonBarPositiveButtonStyle">@style/TextButtonPositive</item>
        <item name="buttonBarNegativeButtonStyle">@style/TextButton</item>
    </style>

    <style name="TextButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">?attr/textColor</item>
        <item name="backgroundTint">?attr/bgColor</item>
    </style>

    <style name="TextButtonPositive" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">?attr/linkColor</item>
        <item name="backgroundTint">?attr/bgColor</item>
    </style>

    <style name="ThemeOverlayAppBottomSheetDialog" parent="ThemeOverlay.MaterialComponents.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

</resources>
